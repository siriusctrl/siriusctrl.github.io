---
import "@fontsource-variable/noto-serif-sc/wght.css";
import { getCollection } from "astro:content";
import ArticlePage from "../../../components/ArticlePage.astro";
import { noteSlug, noteTranslationHrefs } from "../../../data/notes";

export async function getStaticPaths() {
  const notes = await getCollection("notes", ({ data }) => !data.draft);
  return notes
    .filter((note) => note.data.language === "zh")
    .map((note) => ({
      params: { id: noteSlug(note) },
      props: {
        note,
        translations: noteTranslationHrefs(notes, note.data.translationKey),
      },
    }));
}

const { note, translations } = Astro.props;
---

<ArticlePage note={note} translations={translations} />
