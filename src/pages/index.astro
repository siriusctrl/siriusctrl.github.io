---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import NoteArtwork from "../components/NoteArtwork.astro";
import ProjectArtwork from "../components/ProjectArtwork.astro";
import {
  formatMonthYear,
  isRecentProject,
  projectDate,
  projectsByDate,
  type Project,
} from "../data/projects";
import { noteHref, type NoteEntry } from "../data/notes";

const notes = (await getCollection("notes", ({ data }) => !data.draft && data.language === "en"))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const latestNote = notes[0];
if (!latestNote) throw new Error("Home page requires at least one published note");
const siteNote = notes.find((note) => note.data.translationKey === "rebuilding-the-site");
if (!siteNote) throw new Error("Home page requires the rebuilding-the-site note");

const buildDate = new Date();
type RecentItem =
  | { type: "project"; date: Date; project: Project }
  | { type: "note"; date: Date; note: NoteEntry };
const recentItems: RecentItem[] = [
  ...projectsByDate().slice(0, 2).map((project) => ({
    type: "project" as const,
    date: projectDate(project),
    project,
  })),
  { type: "note" as const, date: latestNote.data.publishedAt, note: latestNote },
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const threads = [
  {
    title: "Interfaces beyond the transcript",
    description: "AI output becomes more useful when it can be moved, inspected, and recombined.",
    links: [
      { label: "Freeform Artifacts", href: "/projects/freeform-artifacts/" },
      { label: "Lattice", href: "/projects/lattice/" },
    ],
  },
  {
    title: "Agents with observable state",
    description: "Autonomy is easier to trust when execution leaves a durable, inspectable trace.",
    links: [
      { label: "Fiasco", href: "/projects/fiasco/" },
      { label: "TowerLab", href: "/projects/towerlab/" },
    ],
  },
  {
    title: "Static software as a publishing medium",
    description: "A site can remain static while still offering local, interactive work.",
    links: [
      { label: siteNote.data.title, href: noteHref(siteNote) },
    ],
  },
];
---

<BaseLayout>
  <main class="home-page">
    <section class="home-intro" aria-labelledby="hero-title">
      <p class="home-byline">A working set by Sirius Ctrl</p>
      <h1 id="hero-title">
        Some ideas need to run.
        <span>Others need to be written down.</span>
      </h1>
      <div class="intro-bottom">
        <p class="intro-statement">
          A working set on agents, interfaces, and making complex systems legible.
        </p>
        <div class="intro-links" aria-label="Homepage links">
          <a href="#ideas">Browse the index <Icon name="arrow-right" /></a>
          <a href="/notes/">Read the writing <Icon name="arrow-right" /></a>
        </div>
      </div>
    </section>

    <section class="section recent-section" aria-labelledby="recent-title">
      <div class="recent-heading">
        <h2 id="recent-title">Recently</h2>
        <a href="/projects/">All projects <Icon name="arrow-right" /></a>
      </div>
      <div class="recent-strip">
        {recentItems.map((item, index) => item.type === "project" ? (
          <article class="recent-item" data-recent-item="project">
            <ProjectArtwork
              project={item.project}
              variant="runtime"
              eager={index === 0}
              class="catalog-thumb"
            />
            <h3>
              <a href={`/projects/${item.project.slug}/`}>{item.project.name}</a>
              {isRecentProject(item.project, buildDate) && <span class="badge-new">New</span>}
            </h3>
            <p>{item.project.summary}</p>
            <span class="project-meta">
              <span>{item.project.kind}</span>
              <span><time datetime={item.project.date}>{formatMonthYear(item.date)}</time></span>
            </span>
          </article>
        ) : (
          <article class="recent-item" data-recent-item="note">
            <NoteArtwork src={item.note.data.artwork} alt="" eager={index === 0} class="recent-note-artwork" />
            <h3><a href={noteHref(item.note)}>{item.note.data.title}</a></h3>
            <p>{item.note.data.description}</p>
            <span class="project-meta">
              <span>Essay</span>
              <span><time datetime={item.date.toISOString()}>{formatMonthYear(item.date)}</time></span>
            </span>
          </article>
        ))}
      </div>
    </section>

    <section class="section threads-section" id="ideas" aria-labelledby="threads-title">
      <div class="section-heading compact-heading">
        <h2 id="threads-title">Current threads</h2>
        <p>Questions in progress, expressed through software and writing.</p>
      </div>
      <div class="thread-list">
        {threads.map((thread) => (
          <article class="thread-row">
            <div class="thread-copy">
              <h3>{thread.title}</h3>
              <p>{thread.description}</p>
            </div>
            <div class="thread-links" aria-label={`Forms of ${thread.title}`}>
              {thread.links.map((link) => (
                <a href={link.href}>
                  <span>{link.label}</span>
                  <Icon name="arrow-right" />
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
