---
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/geist-mono/wght.css";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: string;
  languageAlternates?: { hreflang: string; href: string }[];
}

const {
  title = "Working Set",
  description = "Ideas about agents, interfaces, and legible systems, expressed as software and writing.",
  image = "/media/freeform-artifacts.webp",
  lang = "en",
  languageAlternates = [],
} = Astro.props;
const pageTitle = title === "Working Set" ? title : `${title} | Working Set`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eeefeb" />
    <link rel="canonical" href={canonical} />
    {languageAlternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.hreflang}
        href={new URL(alternate.href, Astro.site)}
      />
    ))}
    {languageAlternates.length > 0 && (
      <meta name="working-set-language" content={lang.startsWith("zh") ? "zh" : "en"} />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Working Set writing" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const saved = window.localStorage.getItem("siriusctrl.theme");
        const theme = saved === "light" || saved === "dark"
          ? saved
          : window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute(
          "content",
          theme === "dark" ? "#1b1d1b" : "#eeefeb",
        );
      })();
    </script>
    <script is:inline>
      (() => {
        const marker = document.querySelector('meta[name="working-set-language"]');
        if (!marker) return;
        const current = marker.getAttribute("content");
        const saved = window.localStorage.getItem("siriusctrl.language");
        const browserPrefersChinese = (navigator.languages || [navigator.language])
          .some((language) => language.toLowerCase().startsWith("zh"));
        const preferred = saved === "en" || saved === "zh"
          ? saved
          : browserPrefersChinese ? "zh" : "en";
        if (preferred === current) return;
        const hreflang = preferred === "zh" ? "zh-CN" : "en";
        const alternate = document.querySelector(`link[rel="alternate"][hreflang="${hreflang}"]`);
        if (alternate instanceof HTMLLinkElement) {
          const target = new URL(alternate.href);
          window.location.replace(`${target.pathname}${target.search}${target.hash}`);
        }
      })();
    </script>
  </head>
  <body>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <script>
      const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const root = document.documentElement;
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const revealDuration = 920;
      let themeTransitionRunning = false;
      const themeImagePreloads: HTMLImageElement[] = [];

      const registerThemeImages = (scope: ParentNode) => {
        scope.querySelectorAll<HTMLImageElement>("img").forEach((image) => {
          if (image.dataset.themeSrcLight && image.dataset.themeSrcDark) return;
          const source = image.getAttribute("src");
          const match = source?.match(/^(\/media\/(?:portraits|notes)\/.+)-(?:light|dark)\.svg$/);
          if (!match) return;
          image.dataset.themeSrcLight = `${match[1]}-light.svg`;
          image.dataset.themeSrcDark = `${match[1]}-dark.svg`;
        });
      };

      const syncThemeImages = (scope: ParentNode, theme: "light" | "dark") => {
        registerThemeImages(scope);
        scope.querySelectorAll<HTMLImageElement>("[data-theme-src-light][data-theme-src-dark]")
          .forEach((image) => {
            const source = theme === "dark"
              ? image.dataset.themeSrcDark
              : image.dataset.themeSrcLight;
            if (source && image.getAttribute("src") !== source) image.setAttribute("src", source);
          });
      };

      const preloadThemeImages = (scope: ParentNode, theme: "light" | "dark") => {
        registerThemeImages(scope);
        const sources = new Set<string>();
        scope.querySelectorAll<HTMLImageElement>("[data-theme-src-light][data-theme-src-dark]")
          .forEach((image) => {
            const source = theme === "dark"
              ? image.dataset.themeSrcLight
              : image.dataset.themeSrcDark;
            if (source) sources.add(source);
          });
        for (const source of sources) {
          const preload = new Image();
          preload.src = source;
          void preload.decode().catch(() => undefined);
          themeImagePreloads.push(preload);
        }
      };

      const persistTheme = (theme: "light" | "dark") => {
        document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute(
          "content",
          theme === "dark" ? "#1b1d1b" : "#eeefeb",
        );
        window.localStorage.setItem("siriusctrl.theme", theme);
        const label = `Switch to ${theme === "dark" ? "light" : "dark"} mode`;
        toggle?.setAttribute("aria-label", label);
        toggle?.setAttribute("title", label);
      };

      const commitTheme = (theme: "light" | "dark") => {
        syncThemeImages(document.body, theme);
        root.dataset.theme = theme;
      };

      const cloneThemeSurface = (theme: "light" | "dark") => {
        const documentWidth = Math.max(root.scrollWidth, document.body.scrollWidth, window.innerWidth);
        const documentHeight = Math.max(root.scrollHeight, document.body.scrollHeight, window.innerHeight);
        const layer = document.createElement("div");
        layer.className = "theme-render-layer";
        layer.dataset.themeRenderLayer = "";
        layer.dataset.themeReveal = "";
        layer.dataset.theme = theme;
        layer.setAttribute("aria-hidden", "true");
        layer.inert = true;
        layer.style.setProperty("--theme-render-width", `${documentWidth}px`);
        layer.style.setProperty("--theme-render-height", `${documentHeight}px`);

        const sourceChildren = [...document.body.children].filter((element) =>
          element.tagName !== "SCRIPT" && !element.hasAttribute("data-theme-render-layer")
        );
        for (const source of sourceChildren) {
          const clone = source.cloneNode(true) as HTMLElement;
          clone.querySelectorAll("script").forEach((script) => script.remove());
          syncThemeImages(clone, theme);
          const clonedElements = [clone, ...clone.querySelectorAll<HTMLElement>("*")];
          for (const element of clonedElements) {
            element.removeAttribute("id");
            element.removeAttribute("autofocus");
            for (const attribute of [...element.attributes]) {
              if (attribute.name.startsWith("data-")) element.removeAttribute(attribute.name);
            }
          }
          layer.append(clone);
        }

        document.body.append(layer);
        const renderedHeight = Math.max(documentHeight, layer.scrollHeight);
        layer.style.setProperty("--theme-render-height", `${renderedHeight}px`);
        return layer;
      };

      const initialTheme = root.dataset.theme === "dark" ? "dark" : "light";
      syncThemeImages(document.body, initialTheme);
      preloadThemeImages(document.body, initialTheme);

      toggle?.addEventListener("click", () => {
        if (themeTransitionRunning) return;

        const next = root.dataset.theme === "dark" ? "light" : "dark";
        persistTheme(next);

        if (reducedMotion.matches) {
          commitTheme(next);
          return;
        }

        const bounds = toggle.getBoundingClientRect();
        const visualX = bounds.left + bounds.width / 2;
        const visualY = bounds.top + bounds.height / 2;
        let reveal: HTMLDivElement;
        try {
          reveal = cloneThemeSurface(next);
        } catch {
          commitTheme(next);
          return;
        }

        const layerBounds = reveal.getBoundingClientRect();
        const scaleX = layerBounds.width / reveal.offsetWidth || 1;
        const scaleY = layerBounds.height / reveal.offsetHeight || scaleX;
        const x = (visualX - layerBounds.left) / scaleX;
        const y = (visualY - layerBounds.top) / scaleY;
        const buttonRadius = Math.max(bounds.width / scaleX, bounds.height / scaleY) / 2;
        const visualRadius = Math.hypot(
          Math.max(visualX, window.innerWidth - visualX),
          Math.max(visualY, window.innerHeight - visualY),
        );
        const radius = visualRadius / Math.min(scaleX, scaleY);
        reveal.style.setProperty("--theme-reveal-x", `${x}px`);
        reveal.style.setProperty("--theme-reveal-y", `${y}px`);
        reveal.style.setProperty("--theme-reveal-start-radius", `${buttonRadius}px`);
        reveal.style.setProperty("--theme-reveal-end-radius", `${radius}px`);

        const circle = (value: number) =>
          `circle(${value}px at var(--theme-reveal-x) var(--theme-reveal-y))`;
        let revealAnimation: Animation;
        try {
          revealAnimation = reveal.animate(
            [
              { clipPath: circle(buttonRadius), offset: 0 },
              { clipPath: circle(Math.max(buttonRadius, radius * 0.025)), offset: 0.16 },
              { clipPath: circle(Math.max(buttonRadius, radius * 0.1)), offset: 0.38 },
              { clipPath: circle(Math.max(buttonRadius, radius * 0.31)), offset: 0.62 },
              { clipPath: circle(Math.max(buttonRadius, radius * 0.65)), offset: 0.82 },
              { clipPath: circle(radius), offset: 1 },
            ],
            { duration: revealDuration, easing: "linear", fill: "both" },
          );
        } catch {
          reveal.remove();
          commitTheme(next);
          return;
        }
        revealAnimation.id = "theme-reveal";
        themeTransitionRunning = true;
        root.dataset.themeTransition = "active";
        const initialScrollX = window.scrollX;
        const initialScrollY = window.scrollY;
        let lastScrollX = initialScrollX;
        let lastScrollY = initialScrollY;
        let syncFrame = 0;
        const syncRevealOrigin = () => {
          if (window.scrollX !== lastScrollX || window.scrollY !== lastScrollY) {
            lastScrollX = window.scrollX;
            lastScrollY = window.scrollY;
            reveal.style.setProperty(
              "--theme-reveal-x",
              `${x + (lastScrollX - initialScrollX) / scaleX}px`,
            );
            reveal.style.setProperty(
              "--theme-reveal-y",
              `${y + (lastScrollY - initialScrollY) / scaleY}px`,
            );
          }
          if (themeTransitionRunning) syncFrame = requestAnimationFrame(syncRevealOrigin);
        };
        syncFrame = requestAnimationFrame(syncRevealOrigin);

        let transitionStateCleared = false;
        const finishThemeTransition = () => {
          if (transitionStateCleared) return;
          transitionStateCleared = true;
          cancelAnimationFrame(syncFrame);
          commitTheme(next);
          delete root.dataset.themeTransition;
          reveal.remove();
          themeTransitionRunning = false;
          window.removeEventListener("pagehide", finishThemeTransition);
        };
        revealAnimation.addEventListener("finish", finishThemeTransition, { once: true });
        revealAnimation.addEventListener("cancel", finishThemeTransition, { once: true });
        window.addEventListener("pagehide", finishThemeTransition, { once: true });
      });
    </script>
  </body>
</html>
