---
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/geist-mono/wght.css";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: string;
  languageAlternates?: { hreflang: string; href: string }[];
}

const {
  title = "Working Set",
  description = "Ideas about agents, interfaces, and legible systems, expressed as software and writing.",
  image = "/media/freeform-artifacts.webp",
  lang = "en",
  languageAlternates = [],
} = Astro.props;
const pageTitle = title === "Working Set" ? title : `${title} | Working Set`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eeefeb" />
    <link rel="canonical" href={canonical} />
    {languageAlternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.hreflang}
        href={new URL(alternate.href, Astro.site)}
      />
    ))}
    {languageAlternates.length > 0 && (
      <meta name="working-set-language" content={lang.startsWith("zh") ? "zh" : "en"} />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Working Set writing" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const saved = window.localStorage.getItem("siriusctrl.theme");
        const theme = saved === "light" || saved === "dark"
          ? saved
          : window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute(
          "content",
          theme === "dark" ? "#1b1d1b" : "#eeefeb",
        );
      })();
    </script>
    <script is:inline>
      (() => {
        const marker = document.querySelector('meta[name="working-set-language"]');
        if (!marker) return;
        const current = marker.getAttribute("content");
        const saved = window.localStorage.getItem("siriusctrl.language");
        const browserPrefersChinese = (navigator.languages || [navigator.language])
          .some((language) => language.toLowerCase().startsWith("zh"));
        const preferred = saved === "en" || saved === "zh"
          ? saved
          : browserPrefersChinese ? "zh" : "en";
        if (preferred === current) return;
        const hreflang = preferred === "zh" ? "zh-CN" : "en";
        const alternate = document.querySelector(`link[rel="alternate"][hreflang="${hreflang}"]`);
        if (alternate instanceof HTMLLinkElement) {
          const target = new URL(alternate.href);
          window.location.replace(`${target.pathname}${target.search}${target.hash}`);
        }
      })();
    </script>
  </head>
  <body>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <script>
      type ThemeTransition = {
        ready: Promise<void>;
        finished: Promise<void>;
        skipTransition: () => void;
      };

      const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const transitionDocument = document as Document & {
        startViewTransition?: (update: () => void) => ThemeTransition;
      };

      toggle?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        const applyTheme = () => {
          document.documentElement.dataset.theme = next;
          document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute(
            "content",
            next === "dark" ? "#1b1d1b" : "#eeefeb",
          );
          window.localStorage.setItem("siriusctrl.theme", next);
          const label = `Switch to ${next === "dark" ? "light" : "dark"} mode`;
          toggle.setAttribute("aria-label", label);
          toggle.setAttribute("title", label);
        };

        if (!transitionDocument.startViewTransition || reducedMotion.matches) {
          applyTheme();
          return;
        }

        const bounds = toggle.getBoundingClientRect();
        const x = bounds.left + bounds.width / 2;
        const y = bounds.top + bounds.height / 2;
        const buttonRadius = Math.max(bounds.width, bounds.height) / 2;
        const radius = Math.hypot(
          Math.max(x, window.innerWidth - x),
          Math.max(y, window.innerHeight - y),
        );
        const radiusBasis = Math.hypot(window.innerWidth, window.innerHeight) / Math.SQRT2;
        const position = `${(x / window.innerWidth) * 100}% ${(y / window.innerHeight) * 100}%`;
        const radiusPercent = (value: number) => `${(value / radiusBasis) * 100}%`;
        const transition = transitionDocument.startViewTransition(applyTheme);
        document.documentElement.dataset.themeTransition = "active";
        let revealAnimation: Animation | undefined;
        let yieldedToScroll = false;
        const scrollKeys = new Set([
          "ArrowUp",
          "ArrowDown",
          "PageUp",
          "PageDown",
          "Home",
          "End",
          " ",
        ]);
        const yieldToScroll = () => {
          if (yieldedToScroll) return;
          yieldedToScroll = true;
          revealAnimation?.cancel();
          transition.skipTransition();
        };
        const yieldToScrollKey = (event: KeyboardEvent) => {
          if (scrollKeys.has(event.key)) yieldToScroll();
        };
        const passiveListener = { passive: true } as const;
        window.addEventListener("wheel", yieldToScroll, passiveListener);
        window.addEventListener("touchmove", yieldToScroll, passiveListener);
        window.addEventListener("scroll", yieldToScroll, passiveListener);
        window.addEventListener("keydown", yieldToScrollKey);

        transition.ready
          .then(() => {
            revealAnimation = document.documentElement.animate(
              [
                { clipPath: `circle(0% at ${position})`, offset: 0 },
                { clipPath: `circle(${radiusPercent(buttonRadius)} at ${position})`, offset: 0.16 },
                { clipPath: `circle(${radiusPercent(radius * 0.08)} at ${position})`, offset: 0.38 },
                { clipPath: `circle(${radiusPercent(radius * 0.28)} at ${position})`, offset: 0.62 },
                { clipPath: `circle(${radiusPercent(radius * 0.62)} at ${position})`, offset: 0.82 },
                { clipPath: `circle(${radiusPercent(radius)} at ${position})`, offset: 1 },
              ],
              {
                duration: 860,
                easing: "linear",
                pseudoElement: "::view-transition-new(root)",
              } as KeyframeAnimationOptions & { pseudoElement: string },
            );
          })
          .catch(() => undefined);

        const clearTransitionState = () => {
          delete document.documentElement.dataset.themeTransition;
          window.removeEventListener("wheel", yieldToScroll);
          window.removeEventListener("touchmove", yieldToScroll);
          window.removeEventListener("scroll", yieldToScroll);
          window.removeEventListener("keydown", yieldToScrollKey);
        };
        transition.finished.then(clearTransitionState, clearTransitionState);
      });
    </script>
  </body>
</html>
