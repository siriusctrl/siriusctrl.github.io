---
interface Props {
  name: "arrow-left" | "arrow-right" | "arrow-up-right";
  class?: string;
}

const paths = {
  "arrow-left": "M19 12H5m6 6-6-6 6-6",
  "arrow-right": "M5 12h14m-6-6 6 6-6 6",
  "arrow-up-right": "M7 17 17 7M9 7h8v8",
} as const;

const { name, class: className } = Astro.props;
---

<svg
  class:list={["icon", className]}
  viewBox="0 0 24 24"
  width="1em"
  height="1em"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]} />
</svg>
