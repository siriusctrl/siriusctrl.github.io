---
interface Props {
  src: string;
  alt: string;
  eager?: boolean;
  class?: string;
}

const { src, alt, eager = false, class: className = "" } = Astro.props;
const hasThemeVariants = src.endsWith(".svg") && src.startsWith("/media/notes/");
const lightSource = hasThemeVariants ? src.replace(/\.svg$/, "-light.svg") : src;
const darkSource = hasThemeVariants ? src.replace(/\.svg$/, "-dark.svg") : undefined;
---

<figure class:list={["note-artwork", className]}>
  <img
    src={lightSource}
    data-theme-src-light={hasThemeVariants ? lightSource : undefined}
    data-theme-src-dark={darkSource}
    alt={alt}
    width="1600"
    height="1000"
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
  />
</figure>
